    assertOfficialGrapheme("\u{378}\u{308}\u{378}", [0, 4, 6])
    assertOfficialGrapheme("\u{D}\u{A}\u{61}\u{A}\u{308}", [0, 2, 3, 4, 6])
    assertOfficialGrapheme("\u{61}\u{308}", [0, 3])
    assertOfficialGrapheme("\u{20}\u{200D}\u{646}", [0, 4, 6])
    assertOfficialGrapheme("\u{646}\u{200D}\u{20}", [0, 5, 6])
    assertOfficialGrapheme("\u{1100}\u{1100}", [0, 6])
    assertOfficialGrapheme("\u{AC00}\u{11A8}\u{1100}", [0, 6, 9])
    assertOfficialGrapheme("\u{AC01}\u{11A8}\u{1100}", [0, 6, 9])
    assertOfficialGrapheme("\u{1F1E6}\u{1F1E7}\u{1F1E8}\u{62}", [0, 8, 12, 13])
    assertOfficialGrapheme("\u{61}\u{1F1E6}\u{1F1E7}\u{1F1E8}\u{62}", [0, 1, 9, 13, 14])
    assertOfficialGrapheme("\u{61}\u{1F1E6}\u{1F1E7}\u{200D}\u{1F1E8}\u{62}", [0, 1, 12, 16, 17])
    assertOfficialGrapheme("\u{61}\u{1F1E6}\u{200D}\u{1F1E7}\u{1F1E8}\u{62}", [0, 1, 8, 16, 17])
    assertOfficialGrapheme("\u{61}\u{1F1E6}\u{1F1E7}\u{1F1E8}\u{1F1E9}\u{62}", [0, 1, 9, 17, 18])
    assertOfficialGrapheme("\u{61}\u{200D}", [0, 4])
    assertOfficialGrapheme("\u{61}\u{308}\u{62}", [0, 3, 4])
    assertOfficialGrapheme("\u{61}\u{903}\u{62}", [0, 4, 5])
    assertOfficialGrapheme("\u{61}\u{600}\u{62}", [0, 1, 4])
    assertOfficialGrapheme("\u{1F476}\u{1F3FF}\u{1F476}", [0, 8, 12])
    assertOfficialGrapheme("\u{61}\u{1F3FF}\u{1F476}", [0, 5, 9])
    assertOfficialGrapheme("\u{61}\u{1F3FF}\u{1F476}\u{200D}\u{1F6D1}", [0, 5, 16])
    assertOfficialGrapheme("\u{1F476}\u{1F3FF}\u{308}\u{200D}\u{1F476}\u{1F3FF}", [0, 21])
    assertOfficialGrapheme("\u{1F6D1}\u{200D}\u{1F6D1}", [0, 11])
    assertOfficialGrapheme("\u{61}\u{200D}\u{1F6D1}", [0, 4, 8])
    assertOfficialGrapheme("\u{2701}\u{200D}\u{2701}", [0, 9])
    assertOfficialGrapheme("\u{61}\u{200D}\u{2701}", [0, 4, 7])
    assertOfficialGrapheme("\u{915}\u{924}", [0, 3, 6])
    assertOfficialGrapheme("\u{915}\u{94D}\u{924}", [0, 9])
    assertOfficialGrapheme("\u{915}\u{94D}\u{94D}\u{924}", [0, 12])
    assertOfficialGrapheme("\u{915}\u{94D}\u{200D}\u{924}", [0, 12])
    assertOfficialGrapheme("\u{915}\u{93C}\u{200D}\u{94D}\u{924}", [0, 15])
    assertOfficialGrapheme("\u{915}\u{93C}\u{94D}\u{200D}\u{924}", [0, 15])
    assertOfficialGrapheme("\u{915}\u{94D}\u{924}\u{94D}\u{92F}", [0, 15])
    assertOfficialGrapheme("\u{915}\u{94D}\u{61}", [0, 6, 7])
    assertOfficialGrapheme("\u{61}\u{94D}\u{924}", [0, 4, 7])
    assertOfficialGrapheme("\u{3F}\u{94D}\u{924}", [0, 4, 7])
    assertOfficialGrapheme("\u{915}\u{94D}\u{94D}\u{924}", [0, 12])
}

private func assertOfficialGrapheme(text: String, expected: Array<Int64>): Unit {
    let index = GraphemeIndex(text)
    @Expect(index.count + 1, expected.size)
    for (i in 0..expected.size) {
        @Expect(index.boundary(i), expected[i])
    }
}
